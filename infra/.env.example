# Copier en .env (jamais dans Git). Générer de VRAIS secrets : openssl rand -base64 48
NODE_ENV=production
DOMAINE=sante.example.sn
DATABASE_URL=postgresql://ndiemane:CHANGER@db:5432/ndiemane
SESSION_SECRET=CHANGER
SITE_CODE=NDM
# Clé de chiffrement des sauvegardes : à conserver HORS du serveur (coffre, responsable du poste). Perdue = sauvegardes illisibles.
BACKUP_PASSPHRASE_FILE=/root/.ndiemane/backup.key
BACKUP_DIR=/var/backups/ndiemane
BACKUP_REMOTE=
